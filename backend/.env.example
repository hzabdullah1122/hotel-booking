PORT=5000
NODE_ENV=development

# Local MongoDB or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/stayfield
# Optional: custom DNS servers if mongodb+srv lookups fail on your network
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin(s), comma separated
CLIENT_URL=http://localhost:3001

# Email (any SMTP provider, e.g. Brevo). Leave SMTP_HOST empty to skip emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
SENDER_NAME=Stayfield
